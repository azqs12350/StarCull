/* app.wxss — 全局样式 */

page {
  height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
  background: #fafaf7;
  color: #1a1a1a;
  font-size: 28rpx;
  line-height: 1.55;
}

/* ---------- 通用组件 ---------- */

.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.btn {
  display: inline-block;
  padding: 20rpx 40rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
  line-height: 1;
}

.btn-primary {
  background: #1a1a1a;
  color: #ffffff;
}

.btn-primary::after {
  border: none;
}

.btn-outline {
  background: transparent;
  color: #1a1a1a;
  border: 2rpx solid #1a1a1a;
}

.btn-outline::after {
  border: none;
}

.btn-disabled {
  background: #cccccc;
  color: #ffffff;
}

.btn-disabled::after {
  border: none;
}

.hairline {
  height: 1rpx;
  background: #eaeaea;
  margin: 20rpx 0;
}

.muted {
  color: #888888;
  font-size: 24rpx;
}

.title-zh {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.title-en {
  font-size: 24rpx;
  color: #888888;
  font-style: italic;
  margin-top: 4rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: #f0f0ec;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #666666;
  margin-right: 10rpx;
}

.status-pill {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-pending   { background: #fff6e6; color: #c07a00; }
.status-preparing { background: #e6f0ff; color: #1a66cc; }
.status-shipped   { background: #e6faf0; color: #1a8f4c; }
.status-done      { background: #f0f0ec; color: #666666; }

/* ---------- 表单 ---------- */

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f6f6f3;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #f6f6f3;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* ---------- 空状态 ---------- */

.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #999999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* ---------- 图片 ---------- */

.img-product {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 12rpx;
  background: #f0f0ec;
}

/* ---------- 全局点击反馈 ---------- */

/* 互动按钮（收藏/点赞/点踩）：按下缩放，选中弹跳 */
.ui-interact {
  transition: transform 0.12s ease, opacity 0.12s ease, background 0.12s ease;
}

.ui-press {
  transform: scale(0.92);
  opacity: 0.86;
}

.ui-on {
  animation: ui-pop 0.36s ease-out;
}

@keyframes ui-pop {
  0% { transform: scale(1); }
  35% { transform: scale(1.16); }
  65% { transform: scale(0.96); }
  100% { transform: scale(1); }
}

/* 普通按钮/可点列表项：克制的按压反馈 */
.ui-tap {
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.ui-press-soft {
  transform: scale(0.97);
  opacity: 0.86;
}
