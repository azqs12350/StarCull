/* pages/mine/mine.wxss */

.page {
  padding-bottom: 40rpx;
}

.user-card {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #ececea;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: linear-gradient(135deg, #c9a227, #1a1a1a);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 600;
}

.user-info {
  flex: 1;
  margin-left: 28rpx;
}

.username {
  font-size: 36rpx;
  font-weight: 700;
}

.user-meta {
  margin-top: 6rpx;
}

.meta {
  font-size: 24rpx;
  color: #888888;
}

.lang-switch {
  padding: 10rpx 24rpx;
  background: #f0f0ec;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #555555;
}

.menu-list {
  margin-top: 24rpx;
  background: #ffffff;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0ec;
  line-height: 1;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  line-height: 1;
  display: flex;
  align-items: center;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  line-height: 1;
}

.menu-danger {
  color: #d04759;
}

.menu-val {
  font-size: 24rpx;
  line-height: 1;
  height: 100%;
  display: flex;
  align-items: center;
}

.val-ok { color: #1a8f4c; }
.val-warn { color: #c07a00; }

.menu-arrow {
  font-size: 32rpx;
  color: #cccccc;
  margin-left: 16rpx;
}

/* ---------- 弹窗 ---------- */

.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.modal-panel {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 28rpx 60rpx;
  max-height: 85vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
}

.modal-close {
  font-size: 36rpx;
  color: #999999;
  padding: 10rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 76rpx;
  background: #f6f6f3;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 76rpx;
  background: #f6f6f3;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  color: #999999;
}

.warn-hint {
  padding: 20rpx;
  background: #fff6e6;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #c07a00;
  margin-bottom: 24rpx;
}

.save-btn {
  width: 100%;
  height: 92rpx;
  background: #1a1a1a;
  color: #ffffff;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.save-btn::after { border: none; }
