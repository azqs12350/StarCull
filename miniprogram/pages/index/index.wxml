<!--pages/index/index.wxml-->
<view class="page">

  <!-- 顶部标题栏 + 语言切换 -->
  <view class="header">
    <view class="brand">
      <text class="brand-name">StarCull</text>
      <text class="brand-sub" wx:if="{{lang === 'zh'}}">工作室作品甄选</text>
      <text class="brand-sub" wx:else>Studio Selection</text>
    </view>
    <view class="lang-btn" bindtap="switchLang">
      <text wx:if="{{lang === 'zh'}}">EN</text>
      <text wx:else>中文</text>
    </view>
  </view>

  <!-- 分类筛选 -->
  <scroll-view class="categories" scroll-x="true" enable-flex="true">
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="cat-pill {{activeCategory === item.id ? 'cat-pill-on' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategoryTap"
    >
      <text wx:if="{{lang === 'zh'}}">{{item.zh}}</text>
      <text wx:else>{{item.en}}</text>
    </view>
  </scroll-view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text wx:if="{{lang === 'zh'}}">加载中...</text>
    <text wx:else>Loading...</text>
  </view>

  <!-- 网格列表 -->
  <view class="grid" wx:else>
    <view
      wx:for="{{products}}"
      wx:key="id"
      class="grid-item"
      data-id="{{item.id}}"
      bindtap="goDetail"
      wx:if="{{activeCategory === 'all' || (item.seriesZh || item.seriesEn) === activeCategory}}"
    >
      <image class="grid-img" src="{{item.image}}" mode="aspectFill" lazy-load="true" />
      <view class="grid-info">
        <view class="grid-title">{{lang === 'en' ? (item.titleEn || item.titleZh) : (item.titleZh || item.titleEn)}}</view>
        <view class="grid-actions" catchtap="noop">
          <view class="ga-btn {{item.starred ? 'ga-star-on' : ''}}" data-id="{{item.id}}" bindtap="onStar">
            <text class="ga-ico">{{item.starred ? '★' : '☆'}}</text>
            <text class="ga-num">{{item.count || 0}}</text>
          </view>
          <view class="ga-btn {{item.liked ? 'ga-like-on' : ''}}" data-id="{{item.id}}" bindtap="onLike">
            <text class="ga-ico">👍</text>
            <text class="ga-num">{{item.likeCount || 0}}</text>
          </view>
          <view class="ga-btn {{item.disliked ? 'ga-dislike-on' : ''}}" data-id="{{item.id}}" bindtap="onDislike">
            <text class="ga-ico">👎</text>
            <text class="ga-num">{{item.dislikeCount || 0}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && products.length === 0}}">
    <text class="empty-icon">✨</text>
    <text wx:if="{{lang === 'zh'}}">暂无作品</text>
    <text wx:else>No works yet</text>
  </view>

</view>
