/* pages/index/index.wxss */

.page {
  padding-bottom: 120rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx 16rpx;
}

.brand-name {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #1a1a1a;
}

.brand-sub {
  display: block;
  font-size: 22rpx;
  color: #888888;
  margin-top: 2rpx;
  letter-spacing: 1rpx;
}

.lang-btn {
  padding: 10rpx 24rpx;
  background: #f0f0ec;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #555555;
}

.categories {
  white-space: nowrap;
  padding: 8rpx 24rpx 24rpx;
}

.cat-pill {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background: #f4f4f0;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666666;
}

.cat-pill-on {
  background: #1a1a1a;
  color: #ffffff;
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #999999;
  font-size: 26rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}

.grid-item {
  width: calc(50% - 12rpx);
  margin: 6rpx;
  background: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.grid-img {
  width: 100%;
  height: 340rpx;
  background: #f0f0ec;
}

.grid-info {
  padding: 16rpx 18rpx 18rpx;
}

.grid-title-zh {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.grid-title-en {
  font-size: 22rpx;
  color: #888888;
  font-style: italic;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.grid-meta {
  margin-top: 10rpx;
}

.grid-meta-star {
  font-size: 22rpx;
  color: #c9a227;
}

/* 底部操作栏 */
.grid-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
}

.ga-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 8rpx 0;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #999999;
  background: #f6f6f3;
  margin-right: 8rpx;
}

.ga-btn:last-child {
  margin-right: 0;
}

.ga-ico {
  font-size: 24rpx;
}

.ga-num {
  font-size: 20rpx;
}

.ga-star-on {
  color: #c9a227;
  background: #fffbe6;
}

.ga-like-on {
  color: #e74c3c;
  background: #fef0ef;
}

.ga-dislike-on {
  color: #888888;
  background: #eaeaea;
}

.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #999999;
}

.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
