/* pages/draw/draw.wxss */

.page {
  padding-bottom: 40rpx;
}

.points-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #ececea;
}

.points-label {
  font-size: 26rpx;
  color: #888888;
}

.points-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.draw-hero {
  padding: 40rpx 32rpx;
}

.draw-frame {
  width: 100%;
  height: 480rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f0f0ec;
  position: relative;
}

.draw-img {
  width: 100%;
  height: 100%;
  display: block;
}

.draw-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f5f4f0, #ebe9e2);
}

.ph-icon {
  font-size: 120rpx;
  margin-bottom: 16rpx;
}

.ph-text {
  font-size: 26rpx;
  color: #888888;
}

.prize-tag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: rgba(0,0,0,0.7);
  color: #ffffff;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.draw-controls {
  margin-top: 32rpx;
}

.draw-btn {
  width: 100%;
  height: 100rpx;
  background: #1a1a1a;
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.draw-btn::after { border: none; }

.draw-btn.disabled {
  background: #aaaaaa;
}

/* ---------- 地址表单浮层 ---------- */

.addr-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.addr-panel {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 28rpx 60rpx;
  max-height: 85vh;
  overflow-y: auto;
}

.addr-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.addr-title {
  font-size: 30rpx;
  font-weight: 600;
}

.addr-close {
  font-size: 36rpx;
  color: #999999;
  padding: 10rpx;
}

.addr-row {
  margin-bottom: 16rpx;
}

.addr-input {
  width: 100%;
  height: 76rpx;
  background: #f6f6f3;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.addr-two-col {
  display: flex;
  gap: 16rpx;
}

.addr-half {
  flex: 1;
}

.addr-picker {
  width: 100%;
  height: 76rpx;
  background: #f6f6f3;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #333333;
}

.picker-arrow {
  color: #999999;
}

.addr-paste-btn {
  width: 100%;
  height: 80rpx;
  background: #f6f6f3;
  color: #1a1a1a;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  margin-top: 8rpx;
  margin-bottom: 16rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding: 0;
}

.addr-paste-btn::after { border: none; }

.addr-save-btn {
  width: 100%;
  height: 92rpx;
  background: #1a1a1a;
  color: #ffffff;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 24rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding: 0;
}

.addr-save-btn::after { border: none; }

.upgrade-row {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #fffbe6;
  border-radius: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.upgrade-text {
  font-size: 26rpx;
  color: #9a7b00;
}

.upgrade-btn {
  background: #c9a227;
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 32rpx;
  border: none;
}

.upgrade-btn::after { border: none; }

/* ---------- 抽奖记录 ---------- */

.records {
  padding: 0 28rpx;
}

.records-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.record-card {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}

.record-card.record-clickable {
  cursor: pointer;
  transition: background 0.15s;
}

.record-card.record-clickable:active {
  background: #f6f6f3;
}

.record-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f0f0ec;
  flex-shrink: 0;
}

.record-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.record-title {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-prize {
  font-size: 24rpx;
  color: #666666;
}

.record-code {
  color: #999999;
  font-size: 22rpx;
}

.record-status-row {
  margin-top: 6rpx;
}

.status-pill {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.status-pending   { background: #fff6e6; color: #c07a00; }
.status-preparing { background: #e6f0ff; color: #1a66cc; }
.status-making    { background: #f0e6ff; color: #6a1b9a; }
.status-shipped   { background: #e6faf0; color: #1a8f4c; }
.status-done      { background: #f0f0ec; color: #666666; }
.status-none      { background: #f4f4f0; color: #999999; }

/* 取消升级按钮 */
.cancel-upgrade {
  margin-top: 14rpx;
  padding: 12rpx 18rpx;
  background: #fff0ef;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #d04759;
  text-align: center;
}

.shipping-info {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #888888;
}

/* 未中奖安慰卡 */
.none-card {
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 32rpx 20rpx;
  background: linear-gradient(135deg, #fffaf0 0%, #f7f5ee 100%);
}

.none-emoji {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.none-text {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
}

.none-sub {
  font-size: 22rpx;
  color: #999999;
  margin-top: 6rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #999999;
}

.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

/* 数据加载失败提示 */
.load-error {
  display: flex;
  align-items: center;
  margin: 0 24rpx 20rpx;
  padding: 20rpx 24rpx;
  background: #fff4f2;
  border-radius: 12rpx;
}

.load-error-text {
  flex: 1;
  font-size: 24rpx;
  color: #c0392b;
  margin-right: 16rpx;
}

.load-error-btn {
  margin: 0;
  padding: 0 20rpx;
  background: #c0392b;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 44rpx;
}

/* 抽奖记录骨架 */
.record-skeleton {
  height: 160rpx;
  margin: 12rpx 24rpx;
  border-radius: 14rpx;
  background: #f0f0ec;
  animation: sk-pulse 1.2s ease-in-out infinite;
}

@keyframes sk-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}
