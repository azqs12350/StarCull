<!--pages/draw/draw.wxml-->
<view class="page">

  <!-- 积分显示 -->
  <view class="points-bar">
    <text class="points-label">{{lang === 'zh' ? '我的积分' : 'My Points'}}</text>
    <text class="points-num">{{user ? points : '--'}}</text>
  </view>

  <!-- 后台刷新提示：已有内容时才出现，不遮挡内容，请求结束自动消失 -->
  <view class="refresh-hint" wx:if="{{refreshing}}">
    <view class="refresh-dot"></view>
    <text class="refresh-text">{{lang === 'zh' ? '数据更新中…' : 'Updating…'}}</text>
  </view>

  <!-- 数据加载失败：可重试，不留白屏 -->
  <view class="load-error" wx:if="{{loadError}}">
    <text class="load-error-text">{{lang === 'zh' ? '抽奖数据加载失败，请检查网络' : 'Failed to load draw data. Check your network.'}}</text>
    <button class="load-error-btn" size="mini" bindtap="retryLoad">{{lang === 'zh' ? '重试' : 'Retry'}}</button>
  </view>

  <!-- 抽奖动画区 -->
  <view class="draw-hero">
    <view class="draw-frame" bindtap="openAddrFromResult">
      <block wx:if="{{rolling && rollImage}}">
        <image
          class="draw-img"
          src="{{rollImage}}"
          mode="aspectFill"
        />
      </block>
      <block wx:elif="{{prizeResult && prizeResult.product}}">
        <image
          class="draw-img"
          src="{{prizeResult.product.image}}"
          mode="aspectFill"
          catchtap="onPrizeImageTap"
        />
        <view class="prize-tag">
          <text wx:if="{{prizeResult.prizeType === 'framed'}}">🖼️ {{lang === 'zh' ? '画框作品' : 'Framed'}}</text>
          <text wx:elif="{{prizeResult.prizeType === 'canvas'}}">🎨 {{lang === 'zh' ? '画布作品' : 'Canvas'}}</text>
          <text wx:else>—</text>
        </view>
      </block>
      <block wx:else>
        <view class="draw-placeholder">
          <text class="ph-icon">🎰</text>
          <text class="ph-text">{{lang === 'zh' ? '点击下方按钮开始抽奖' : 'Tap below to try your luck'}}</text>
        </view>
      </block>
    </view>

    <view class="draw-controls">
      <button
        class="draw-btn {{(rolling || drawing || (!user && !needLogin)) ? 'disabled' : ''}}"
        bindtap="onDraw"
        disabled="{{!needLogin && (!user || rolling || drawing)}}"
      >
        <text wx:if="{{needLogin}}">{{lang === 'zh' ? '请先登录' : 'Please sign in'}}</text>
        <text wx:elif="{{!user && loadError}}">{{lang === 'zh' ? '加载失败' : 'Load failed'}}</text>
        <text wx:elif="{{!user}}">{{lang === 'zh' ? '加载中...' : 'Loading...'}}</text>
        <text wx:elif="{{rolling || drawing}}">{{lang === 'zh' ? '抽奖中...' : 'Drawing...'}}</text>
        <text wx:elif="{{user.freeDrawClaimed && points < 50}}">{{lang === 'zh' ? '积分不足' : 'Not enough points'}}</text>
        <text wx:elif="{{canFreeDraw()}}">🎁 {{lang === 'zh' ? '免费抽一次' : 'Free draw'}}</text>
        <text wx:else>🎲 {{lang === 'zh' ? '抽奖 (50 积分)' : 'Draw (50 pts)'}}</text>
      </button>
    </view>
  </view>

  <!-- 地址表单（浮层/弹窗形式） -->
  <view class="addr-mask" wx:if="{{showAddress}}" bindtap="closeAddress">
    <view class="addr-panel" catchtap="noop">
      <view class="addr-header">
        <text class="addr-title">{{lang === 'zh' ? '🎯 中奖了！请填写收货地址' : '🎯 You won! Shipping address'}}</text>
        <text class="addr-close" bindtap="closeAddress">✕</text>
      </view>

      <view class="addr-body">
        <view class="addr-row">
          <picker bindchange="onCountryChange" range="{{countryOptions}}" range-key="{{lang === 'zh' ? 'zh' : 'en'}}">
            <view class="addr-picker">
              {{addr.country || (lang === 'zh' ? '请选择国家' : 'Select country')}}
              <text class="picker-arrow">▾</text>
            </view>
          </picker>
        </view>
        <view class="addr-row">
          <input class="addr-input" placeholder="{{lang === 'zh' ? '收件人' : 'Recipient'}}" value="{{addr.name}}" data-field="name" bindinput="onAddrInput" />
        </view>
        <view class="addr-row">
          <input class="addr-input" placeholder="{{lang === 'zh' ? '电话' : 'Phone'}}" value="{{addr.phone}}" data-field="phone" bindinput="onAddrInput" />
        </view>
        <view class="addr-row">
          <input class="addr-input" placeholder="{{lang === 'zh' ? '邮箱（可选）' : 'Email (optional)'}}" value="{{addr.email}}" data-field="email" bindinput="onAddrInput" />
        </view>
        <view class="addr-row addr-two-col">
          <input class="addr-input addr-half" placeholder="{{lang === 'zh' ? '省/州' : 'State / Province'}}" value="{{addr.state}}" data-field="state" bindinput="onAddrInput" />
          <input class="addr-input addr-half" placeholder="{{lang === 'zh' ? '邮编' : 'Postal code'}}" value="{{addr.zip}}" data-field="zip" bindinput="onAddrInput" />
        </view>
        <view class="addr-row">
          <input class="addr-input" placeholder="{{lang === 'zh' ? '城市' : 'City'}}" value="{{addr.city}}" data-field="city" bindinput="onAddrInput" />
        </view>
        <view class="addr-row">
          <input class="addr-input" placeholder="{{lang === 'zh' ? '地址' : 'Address'}}" value="{{addr.address1}}" data-field="address1" bindinput="onAddrInput" />
        </view>
        <view class="addr-row">
          <input class="addr-input" placeholder="{{lang === 'zh' ? '地址第二行（可选）' : 'Address line 2 (optional)'}}" value="{{addr.address2}}" data-field="address2" bindinput="onAddrInput" />
        </view>

        <button class="addr-paste-btn" bindtap="pasteAddress">{{lang === 'zh' ? '📋 从剪贴板粘贴地址' : '📋 Paste from clipboard'}}</button>
        <button class="addr-save-btn" bindtap="saveAddress">{{lang === 'zh' ? '保存地址' : 'Save address'}}</button>

        <!-- 画框升级（仅 canvas 类型且未升级时显示） -->
        <view class="upgrade-row" wx:if="{{prizeResult && prizeResult.prizeType === 'canvas' && !prizeResult.framedUpgrade}}">
          <text class="upgrade-text">{{lang === 'zh' ? '想升级为带画框版本？' : 'Upgrade to framed version?'}}</text>
          <button class="upgrade-btn" bindtap="onUpgrade" size="mini">{{lang === 'zh' ? '升级 (300 积分)' : 'Upgrade (300 pts)'}}</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 抽奖记录骨架：数据未到先占位 -->
  <view class="records" wx:if="{{loading && !draws.length}}">
    <view class="records-title">
      <text wx:if="{{lang === 'zh'}}">我的抽奖记录</text>
      <text wx:else>My Draws</text>
    </view>
    <view class="record-skeleton"></view>
    <view class="record-skeleton"></view>
  </view>

  <!-- 抽奖记录 -->
  <view class="records" wx:elif="{{draws.length}}">
    <view class="records-title">
      <text wx:if="{{lang === 'zh'}}">我的抽奖记录</text>
      <text wx:else>My Draws</text>
    </view>

    <!-- 中奖记录：完整卡片 -->
    <view
      wx:for="{{draws}}"
      wx:for-item="item"
      wx:key="id"
      class="record-card {{item.status === 'pending' || item.status === 'preparing' ? 'record-clickable' : ''}}"
      wx:if="{{item.prizeType !== 'none'}}"
      data-id="{{item.id}}"
      bindtap="openAddrFromRecord"
    >
      <image
        wx:if="{{item.product}}"
        class="record-img"
        src="{{item.product.image}}"
        mode="aspectFill"
      />
      <view class="record-info">
        <view class="record-title">
          {{lang === 'en' ? (item.product.titleEn || item.product.titleZh || 'Prize') : (item.product.titleZh || item.product.titleEn || '中奖作品')}}
        </view>
        <view class="record-prize">
          <text wx:if="{{item.prizeType === 'framed'}}">🖼️ {{lang === 'zh' ? '画框（带画框）' : 'Framed'}}</text>
          <text wx:elif="{{item.prizeType === 'canvas'}}">🎨 {{lang === 'zh' ? '画布（不带画框）' : 'Canvas'}}</text>
          <text class="record-code" wx:if="{{item.code}}">· {{item.code}}</text>
        </view>
        <view class="record-status-row">
          <text wx:if="{{item.status === 'pending'}}" class="status-pill status-pending">{{lang === 'zh' ? '待填地址' : 'Address needed'}}</text>
          <text wx:elif="{{item.status === 'preparing'}}" class="status-pill status-preparing">{{lang === 'zh' ? '准备中' : 'Preparing'}}</text>
          <text wx:elif="{{item.status === 'making'}}" class="status-pill status-making">{{lang === 'zh' ? '制作中' : 'Making'}}</text>
          <text wx:elif="{{item.status === 'shipped'}}" class="status-pill status-shipped">{{lang === 'zh' ? '已发货' : 'Shipped'}}</text>
          <text wx:elif="{{item.status === 'done'}}" class="status-pill status-done">{{lang === 'zh' ? '已完结' : 'Completed'}}</text>
          <text wx:else class="status-pill">{{item.status}}</text>
        </view>
        <!-- 快递信息 -->
        <view class="shipping-info" wx:if="{{item.status === 'shipped' || item.status === 'done'}}">
          <text wx:if="{{item.shipping.trackingNumber}}">{{lang === 'zh' ? '物流单号: ' : 'Tracking: '}}{{item.shipping.trackingNumber}}</text>
        </view>
        <!-- 取消升级按钮 -->
        <view class="cancel-upgrade" wx:if="{{item.framedUpgrade && (item.status === 'pending' || item.status === 'preparing')}}" catchtap="onCancelUpgrade" data-id="{{item.id}}">
          {{lang === 'zh' ? '🗑️ 取消升级（返还300积分）' : '🗑️ Cancel upgrade (refund 300 pts)'}}
        </view>
      </view>
    </view>

    <!-- 未中奖：只显示一张汇总安慰卡 -->
    <view class="record-card none-card" wx:if="{{noneCount > 0}}">
      <view class="none-emoji">{{noneEmoji}}</view>
      <view class="none-text">{{noneText}}</view>
      <view class="none-sub" wx:if="{{lang === 'zh'}}">共 {{noneCount}} 次 · 再接再厉，好运在路上 🍀</view>
      <view class="none-sub" wx:else>{{noneCount}} draws · Better luck next time 🍀</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:elif="{{user && !loadError}}">
    <text class="empty-icon">🎰</text>
    <text wx:if="{{lang === 'zh'}}">还没有抽奖记录</text>
    <text wx:else>No draws yet</text>
  </view>

</view>
