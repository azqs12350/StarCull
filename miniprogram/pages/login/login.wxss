/* pages/login/login.wxss */

.page {
  padding: 60rpx 48rpx 60rpx;
}

.brand {
  text-align: center;
  margin-bottom: 60rpx;
}

.brand-name {
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  color: #1a1a1a;
  display: block;
}

.brand-sub {
  font-size: 24rpx;
  color: #888888;
  letter-spacing: 2rpx;
  margin-top: 8rpx;
  display: block;
}

.tabs {
  display: flex;
  background: #f4f4f0;
  border-radius: 48rpx;
  padding: 8rpx;
  margin-bottom: 40rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666666;
  transition: all 0.2s;
}

.tab-on {
  background: #ffffff;
  color: #1a1a1a;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #f6f6f3;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 88rpx;
  background: #f6f6f3;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #333333;
}

.picker-arrow {
  color: #999999;
}

.divider {
  margin: 40rpx 0 32rpx;
}

.divider-text {
  font-size: 24rpx;
  color: #888888;
}

.warn-hint {
  padding: 20rpx 24rpx;
  background: #fff6e6;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #c07a00;
  margin-bottom: 28rpx;
}

.sec-question-card {
  background: #f6f6f3;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
}

.sq-label {
  font-size: 22rpx;
  color: #888888;
  display: block;
  margin-bottom: 6rpx;
}

.sq-text {
  font-size: 28rpx;
  color: #1a1a1a;
}

.submit-btn {
  width: 100%;
  height: 100rpx;
  background: #1a1a1a;
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 20rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.submit-btn::after { border: none; }

.form-extra {
  text-align: center;
  margin-top: 24rpx;
}

.link {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.link-sub {
  font-size: 24rpx;
  color: #888888;
}

/* 分隔线 */
.divider-line {
  display: flex;
  align-items: center;
  margin: 48rpx 0 28rpx;
}

.divider-line::before,
.divider-line::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #e0e0dc;
}

.divider-line-text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 微信登录按钮 */
.wechat-btn {
  width: 100%;
  height: 100rpx;
  background: #07c160;
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  margin-top: 8rpx;
}

.wechat-btn::after { border: none; }

.wechat-icon {
  margin-right: 8rpx;
}
